{
  "$description": "Ponto Afeto — Cozy Handmade Studio. Tokens no formato W3C Design Tokens (DTCG). Importáveis como variáveis no Figma via plugin (Tokens Studio, Variables Import) ou pela importação nativa de variáveis, quando disponível no seu plano. Espelham src/index.css.",
  "color": {
    "$type": "color",
    "base": {
      "cream": { "$value": "#FFF8EF", "$description": "Creme — fundo da página" },
      "ivory": { "$value": "#FFFDF9", "$description": "Marfim — superfícies" },
      "white": { "$value": "#FFFFFF" },
      "sand": { "$value": "#F3E6D6", "$description": "Areia — placeholders e hovers" },
      "sand-line": { "$value": "#E8D7C3", "$description": "Linhas tracejadas e bordas" },
      "terracotta": { "$value": "#D98268", "$description": "Terracota suave — marca e ilustração" },
      "terracotta-deep": { "$value": "#B0553D", "$description": "Terracota profunda — CTA (4,98:1 com branco)" },
      "terracotta-ink": { "$value": "#8F4230", "$description": "Hover do CTA, eyebrows" },
      "rose": { "$value": "#E9A6A6", "$description": "Rosa antigo" },
      "rose-soft": { "$value": "#F8E1DC" },
      "butter": { "$value": "#F4D06F", "$description": "Amarelo manteiga — destaque" },
      "butter-soft": { "$value": "#FBEDC4" },
      "sage": { "$value": "#A8B89F", "$description": "Verde sálvia" },
      "sage-soft": { "$value": "#E3EADC" },
      "sage-deep": { "$value": "#4A6B45", "$description": "WhatsApp e sucesso (6:1 com branco)" },
      "sage-ink": { "$value": "#3A5636" },
      "lavender": { "$value": "#B9B0D9", "$description": "Azul lavanda — só para 'sob encomenda'" },
      "lavender-soft": { "$value": "#EBE7F5" },
      "lavender-ink": { "$value": "#4B4270" },
      "cocoa": { "$value": "#5C4033", "$description": "Marrom cacau — títulos e seções escuras" },
      "cocoa-mid": { "$value": "#765443", "$description": "Marrom médio ajustado para AA (o #8A6654 original falha em fundos tingidos)" },
      "cocoa-soft": { "$value": "#8A6654", "$description": "Marrom médio original — só decorativo" },
      "ink": { "$value": "#3F3029", "$description": "Texto principal" },
      "error": { "$value": "#A63A2B" }
    },
    "role": {
      "primary": { "$value": "{color.base.terracotta}", "$description": "Cor principal da marca" },
      "secondary": { "$value": "{color.base.sage}", "$description": "Cor secundária" },
      "accent": { "$value": "{color.base.butter}", "$description": "Destaque" },
      "background": { "$value": "{color.base.cream}" },
      "surface": { "$value": "{color.base.ivory}" },
      "text": { "$value": "{color.base.ink}" },
      "text-heading": { "$value": "{color.base.cocoa}" },
      "text-muted": { "$value": "{color.base.cocoa-mid}" },
      "border": { "$value": "{color.base.sand-line}" },
      "cta": { "$value": "{color.base.terracotta-deep}" },
      "cta-hover": { "$value": "{color.base.terracotta-ink}" },
      "whatsapp": { "$value": "{color.base.sage-deep}" },
      "success": { "$value": "{color.base.sage-deep}" },
      "alert": { "$value": "{color.base.error}" },
      "focus-ring": { "$value": "{color.base.terracotta-deep}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Fraunces", "Georgia", "serif"], "$description": "Títulos. Eixos: SOFT 100, WONK 1 em H1/H2, opsz automático" },
      "body": { "$value": ["Figtree", "system-ui", "sans-serif"], "$description": "Texto, preços, botões, formulários" },
      "hand": { "$value": ["Caveat", "cursive"], "$description": "Só notas decorativas curtas" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display-h1-desktop": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "70px", "lineHeight": 1.02, "letterSpacing": "-0.015em" } },
    "display-h1-mobile": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "42px", "lineHeight": 1.02, "letterSpacing": "-0.015em" } },
    "display-h2-desktop": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "48px", "lineHeight": 1.08, "letterSpacing": "-0.015em" } },
    "display-h2-mobile": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "34px", "lineHeight": 1.08, "letterSpacing": "-0.015em" } },
    "display-h3": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "28px", "lineHeight": 1.15, "letterSpacing": "-0.01em" } },
    "product-name": { "$value": { "fontFamily": "{font.family.display}", "fontWeight": 600, "fontSize": "20px", "lineHeight": 1.3, "letterSpacing": "0" } },
    "body-l": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.6, "letterSpacing": "0" } },
    "body-m": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "16px", "lineHeight": 1.6, "letterSpacing": "0" } },
    "body-s": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.5, "letterSpacing": "0" } },
    "price": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 700, "fontSize": "17px", "lineHeight": 1.3, "letterSpacing": "0" } },
    "button": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 600, "fontSize": "15px", "lineHeight": 1, "letterSpacing": "0" } },
    "eyebrow": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 700, "fontSize": "13px", "lineHeight": 1.2, "letterSpacing": "0.14em" } },
    "badge": { "$value": { "fontFamily": "{font.family.body}", "fontWeight": 700, "fontSize": "11.5px", "lineHeight": 1.2, "letterSpacing": "0.08em" } },
    "hand-note": { "$value": { "fontFamily": "{font.family.hand}", "fontWeight": 600, "fontSize": "24px", "lineHeight": 1.1, "letterSpacing": "0" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "28": { "$value": "112px" },
    "gutter-mobile": { "$value": "16px" },
    "gutter-tablet": { "$value": "24px" },
    "gutter-desktop": { "$value": "40px" },
    "container": { "$value": "1320px" },
    "section-y-mobile": { "$value": "80px" },
    "section-y-desktop": { "$value": "112px" }
  },
  "radius": {
    "$type": "dimension",
    "input": { "$value": "12px" },
    "card": { "$value": "24px" },
    "block": { "$value": "36px" },
    "pill": { "$value": "999px" },
    "arch-top": { "$value": "999px", "$description": "Fotos em arco: 999 999 24 24" },
    "arch-bottom": { "$value": "24px" }
  },
  "shadow": {
    "$type": "shadow",
    "soft": { "$value": [{ "color": "#5C40330F", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#5C40332E", "offsetX": "0px", "offsetY": "6px", "blur": "18px", "spread": "-8px" }] },
    "lift": { "$value": [{ "color": "#5C40330F", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" }, { "color": "#5C403352", "offsetX": "0px", "offsetY": "22px", "blur": "40px", "spread": "-18px" }] },
    "paper": { "$value": { "color": "#5C403340", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "-12px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "micro": { "$value": "200ms", "$description": "Hover, cores" },
      "small": { "$value": "350ms", "$description": "Accordion, toast, chips" },
      "medium": { "$value": "450ms", "$description": "Diálogos, cards entrando" },
      "reveal": { "$value": "650ms", "$description": "Entrada de seção ao rolar" },
      "draw": { "$value": "2400ms", "$description": "Fio decorativo da hero (uma vez)" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out-soft": { "$value": [0.22, 1, 0.36, 1] },
      "in-soft": { "$value": [0.55, 0, 0.75, 0.2] }
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "xs": { "$value": "416px" },
    "sm": { "$value": "640px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "1024px" },
    "xl": { "$value": "1280px" }
  }
}
